# =============================================================================
# Autonomous AI System — Environment Variables
# =============================================================================
# Copy to .env for local development.
# In production use GitHub Secrets (Settings → Secrets → Actions).
# NEVER commit a .env file with real values.
#
# =============================================================================

# ── Supabase / PostgreSQL (all phases) ────────────────────────────────────
# These are used to derive a PostgreSQL connection string for all phases.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# ── Single shared database URL (recommended for production) ──────────────
# If set, ALL phases 7-10 will use this database (different tables per phase).
# Overrides SUPABASE_* derivation and phase-specific URLs below.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# ── Phase-specific database URLs (optional overrides) ────────────────────
# Only needed if you want each phase on a separate database.
# If not set, DATABASE_URL or SUPABASE_* derivation is used.
OBSERVATION_DB_DSN=postgresql+psycopg2://user:pass@host:5432/observation
LEARNING_LAYER_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/learning
KCL_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/knowledge_coverage
P10_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/intelligence_core

# ── Google / Drive / Sheets ───────────────────────────────────────────────
# Spreadsheet ID from URL: /d/<ID>/edit
GOOGLE_SHEET_ID=your_spreadsheet_id
# Drive folder for post videos
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id
# base64 -w 0 service_account.json
GOOGLE_SERVICE_ACCOUNT_JSON_B64=base64_service_account_here
# base64 -w 0 token.json  (OAuth token for Drive)
GOOGLE_OAUTH_TOKEN_JSON_B64=base64_oauth_token_here

# ── Gemini API (FREE tier only) ───────────────────────────────────────────
# Get keys: https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=your_key_1
GEMINI_API_KEY_2=your_key_2
GEMINI_API_KEY_3=your_key_3
# Dedicated key for image moderation — never competes for text-gen quota
GEMINI_API_KEY_IMAGE_CHECK=your_image_key
#
# ── Independent model configuration ──────────────────────────────────────
# There are FOUR independent model variables.  They are NOT derived from each
# other.  Changing ROTATION_MODELS does NOT affect DEFAULT_TEXT_MODEL,
# IMAGE_VETTING_MODEL, or LEARNING_MODEL.
#
# DEFAULT_TEXT_MODEL — used for all general text generation tasks.
#   Default: gemini-3.5-flash-lite
DEFAULT_TEXT_MODEL=gemini-3.5-flash-lite
#
# IMAGE_VETTING_MODEL — used exclusively for image selection / moderation.
#   Must NEVER be derived from ROTATION_MODELS position.
#   Default: gemini-3.5-flash-lite
IMAGE_VETTING_MODEL=gemini-3.5-flash-lite
#
# LEARNING_MODEL — used for learning-layer / analysis tasks.
#   Default: gemini-3.5-flash
LEARNING_MODEL=gemini-3.5-flash
#
# ── Rotation engine model list ────────────────────────────────────────────
# ROTATION_MODELS controls ONLY the health-aware GeminiRotationEngine.
# It defines the tiebreaker order when pairs are equally healthy.
# Changing this variable has NO effect on DEFAULT_TEXT_MODEL, IMAGE_VETTING_MODEL,
# or LEARNING_MODEL.
#
# Format: comma-separated model names, no spaces.
# Only stable free-tier identifiers are permitted:
#   - NO aliases (latest, preview, experimental)
#   - NO Pro models
#   - NO image/video/audio/TTS/music/embedding models
#
# Default (omit to use this value):
ROTATION_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.6-flash
#
# Example: promote gemini-3.5-flash to first in the rotation tiebreaker:
# ROTATION_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.6-flash
#
# Legacy alias (accepted for backwards compatibility):
# GEMINI_MODEL_ROTATION=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.6-flash
#
# Rotation state is persisted in gemini_rotation_state.json (local) or
# the operational database. State survives between GitHub Actions runs.

# ── Instagram / Meta ──────────────────────────────────────────────────────
IG_ACCESS_TOKEN=your_long_lived_token    # ~60 days, auto-refreshed weekly
IG_BUSINESS_ID=your_ig_business_id
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret

# ── Telegram notifications ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── Pixabay (background images) ───────────────────────────────────────────
PIXABAY_API_KEY=your_pixabay_key

# ── GitHub (auto-fix PRs, backup upload, secret rotation) ─────────────────
GH_PAT=your_github_pat   # needs: repo + secrets scopes
# GH_REPO is set automatically from github.repository in workflows

# ── Operational Layer ─────────────────────────────────────────────────────
SCHEDULER_TIMEZONE=Asia/Baghdad
BACKUP_RETENTION_DAYS=30
LOG_DIR=./logs
LOG_LEVEL=INFO
HEALTH_STATUS_FILE=./logs/health_status.json

# ── Gemini rotation state ─────────────────────────────────────────────────
# Path to persistent rotation state JSON (default: ./gemini_rotation_state.json)
# GEMINI_STATE_FILE=./gemini_rotation_state.json

# ── SQLite fallback (TESTS ONLY) ─────────────────────────────────────────
# Set to "true" only in CI/test environments. NEVER in production.
# ALLOW_SQLITE_FALLBACK=true

# ── Cron schedule reference (UTC — schedules shown in Baghdad time UTC+3) ──
# measurement.yml:  0 2 * * *     → 05:00 Baghdad daily
# publish.yml:      */15 * * * *  → every 15 min
# decision.yml:     30 1 * * *    → 04:30 Baghdad daily
# learning.yml:     0 0 * * *     → 03:00 Baghdad daily
# strategy.yml:     0 1 1 * *     → 04:00 Baghdad, 1st of month
# cleanup.yml:      0 20 * * *    → 23:00 Baghdad daily
# health_check.yml: */30 * * * *  → every 30 min
# token_refresh.yml:0 23 * * 6   → Sunday 02:00 Baghdad (Sat 23:00 UTC)
# backup.yml:       0 0 * * 0    → Sunday 03:00 Baghdad (Sun 00:00 UTC)
